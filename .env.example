# IDscnr environment configuration — copy to .env and fill in real values.
# Never commit the real .env file (it is gitignored).

# --- Security ---
# Secret used to sign auth JWTs. Falls back to an insecure hardcoded value
# if unset — always set this explicitly. Generate with: openssl rand -hex 32
JWT_SECRET=
# Legacy/optional additional encryption key input (image encryption key is
# otherwise auto-generated into backend/config/secret.key on first run).
ENCRYPTION_KEY=

# --- OCR ---
# "tesseract" (default, local, no key needed) or "google" (opt-in, cloud).
OCR_PROVIDER=tesseract
# Required only if OCR_PROVIDER=google or you enable the Google Vision
# provider in Settings. Get your own key — never hardcode it in source.
GOOGLE_API_KEY=
GOOGLE_OCR_RPM=

# --- Database ---
DATABASE_URL=sqlite:///./backend/data/guestdb.sqlite

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- PMS export ---
# "json", "csv", or "api"
PMS_EXPORT_MODE=json
PMS_EXPORT_PATH=
# Window title substring to target for keystroke-based autofill (Windows only)
PMS_WINDOW_TITLE=

# --- File storage ---
SCANS_DIR=
BACKUP_DIR=
TEMP_DIR=
